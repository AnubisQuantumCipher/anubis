[Desktop Entry]
Type=Application
Version=1.5
Name=ANUBIS Vault
GenericName=File Encryption
Comment=Post-quantum file encryption: X25519 + ML-KEM-1024, ML-DSA-87 signatures
Exec=anubis-desktop %f
